    "To save power, window animations are\nunavailable in Low Power Mode." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "To save power, window animations are\nunavailable in Low Power Mode."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um Energie zu sparen, sind Fensteranimationen\nim Energiesparmodus nicht verfügbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To save power, window animations are\nunavailable in Low Power Mode."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "To save power, window animations are\nunavailable in Low Power Mode."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour économiser de l’énergie, les animations de fenêtres\nne sont pas disponibles en mode basse énergie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per risparmiare batteria, le animazioni sono disattivate\ndurante la modalità Risparmio energetico."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "省エネルギーモードでは、ウインドウの\nアニメーションは無効になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전원 절약을 위해 저전력 모드에서는 창 애니메이션을 사용할 수 없습니다."
          }
        },
        "nl-BE" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om energie te besparen zijn vensteranimaties in beschikbaar in de Low Power modus."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby oszczędzać baterię, animacje są wyłączone w trybie niskiego zużycia energii."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para economizar energia, as animações das janelas são\nindisponível no Modo de Baixa Energia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Анимации недоступны в режиме энергосбережения."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "窗口动画将在低电量模式下被禁用以节省功耗。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "視窗動畫將在低電量模式下被禁用以節省能耗。"
          }
        }
      }
    },
