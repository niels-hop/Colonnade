//
//  Config.xcconfig
//  Colonnade
//
//  Created by Kai Azim on 2023-08-09.
//

VERSION = 0.0.0
BUILD_NUMBER = 0

// Signing. Public builds default to ad-hoc signing ("-") so anyone can build the project without an
// Apple Developer account. To keep macOS' Accessibility permission across rebuilds, create a stable
// self-signed code-signing certificate and name it in `Local.xcconfig` (gitignored), e.g.:
//
//     CODE_SIGN_IDENTITY = Colonnade Self-Signed
//
// See README.md ("Building from source") for the one-time certificate setup.
CODE_SIGN_IDENTITY = -
CODE_SIGN_STYLE = Manual

#include? "Local.xcconfig"
